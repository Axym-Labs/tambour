<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestApp.fs" />
    <Compile Include="FigurePaneTests.fs" />
    <Compile Include="ProtocolTests.fs" />
    <Compile Include="WorkerTests.fs" />
    <Compile Include="ShellTests.fs" />
    <Compile Include="AnalysisTests.fs" />
    <Compile Include="EditorTests.fs" />
    <Compile Include="EditsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="scripts/**/*.fsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tambour/Tambour.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

</Project>
