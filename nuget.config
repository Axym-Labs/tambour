<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Marey comes from the local feed that tools/marey-feed.sh fills, until 1.0.0 is published;
       every other package from nuget.org. The mapping keeps the two from standing in for each
       other. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="marey-local" value="artifacts/marey-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="marey-local">
      <package pattern="Marey" />
      <package pattern="Marey.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
