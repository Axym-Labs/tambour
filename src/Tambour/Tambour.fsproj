<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tambour</AssemblyName>
    <RootNamespace>Tambour</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Paths.fs" />
    <Compile Include="Evaluation.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="FigurePane.fs" />
    <Compile Include="App.fs" />
    <Compile Include="SelfCheck.fs" />
    <Compile Include="PaneCheck.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tambour.Protocol/Tambour.Protocol.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Marey" />
    <PackageReference Include="Marey.Backend.Skia" />
    <PackageReference Include="Marey.Backend.Gpu" />
    <PackageReference Include="FSharp.Compiler.Service" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="HarfBuzzSharp" />
  </ItemGroup>

</Project>
