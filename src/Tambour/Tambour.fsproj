<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tambour</AssemblyName>
    <RootNamespace>Tambour</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Paths.fs" />
    <Compile Include="Preferences.fs" />
    <Compile Include="Palette.fs" />
    <Compile Include="Evaluation.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="FigurePane.fs" />
    <Compile Include="TableGrid.fs" />
    <Compile Include="History.fs" />
    <Compile Include="Typing.fs" />
    <Compile Include="ScriptEditor.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Project.fs" />
    <Compile Include="Tables.fs" />
    <Compile Include="Plotting.fs" />
    <Compile Include="Shell.fs" />
    <Compile Include="AnalysisCheck.fs" />
    <Compile Include="SelfCheck.fs" />
    <Compile Include="PaneCheck.fs" />
    <Compile Include="PackageCheck.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes/light.json" LogicalName="Tambour.Themes.light.json" />
    <EmbeddedResource Include="Themes/dark.json" LogicalName="Tambour.Themes.dark.json" />
    <AvaloniaResource Include="Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tambour.Protocol/Tambour.Protocol.fsproj" />
    <ProjectReference Include="../Tambour.Edits/Tambour.Edits.fsproj" />
    <ProjectReference Include="../Tambour.Data/Tambour.Data.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Marey" />
    <PackageReference Include="Marey.Backend.Skia" />
    <PackageReference Include="Marey.Backend.Gpu" />
    <PackageReference Include="FSharp.Compiler.Service" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.FuncUI" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="TextMateSharp.Grammars" />
    <PackageReference Include="Avalonia.FuncUI.Elmish" />
    <PackageReference Include="Elmish" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="HarfBuzzSharp" />
  </ItemGroup>


</Project>
